# Banco: PostgreSQL (Docker Compose) ou "pglite://./.pglite/dev" para desenvolvimento sem Docker
DATABASE_URL=postgres://ljc:ljc@localhost:5432/ljc
# Origem pública do app (usada para verificação CSRF de Origin e links)
APP_URL=http://localhost:3000
# Segredo para HMAC de tokens (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio
TZ=America/Maceio
# Diretório privado de uploads (fora de /public)
STORAGE_DIR=./storage
# Credenciais do primeiro administrador (usadas apenas por npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
