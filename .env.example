# Banco: PostgreSQL (produção / Docker Compose)
DATABASE_URL=postgres://ljc:ljc@localhost:5432/ljc
# Sem Docker (desenvolvimento): PGlite, com a pasta FORA do projeto
# DATABASE_URL=pglite://C:/Users/SEU_USUARIO/ljc-data/pglite/dev

# Endereço público do site (usado em links enviados por WhatsApp, sitemap e redefinição de senha)
APP_URL=http://localhost:3000

# Segredo longo e aleatório. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio

TZ=America/Maceio

# Pasta privada das fotos das OS (fora de /public; faça backup dela)
STORAGE_DIR=./storage

# Primeiro administrador (usado só por npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Docker Compose (produção): senha do Postgres
POSTGRES_PASSWORD=troque-esta-senha
